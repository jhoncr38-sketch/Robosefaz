# =====================================================================
# SIAT Automation — variáveis de ambiente
# Copie para .env (worker) e apps/web/.env.local (painel). NUNCA commite .env.
# =====================================================================

# ---------------------------------------------------------------------
# WEB (apps/web/.env.local)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL da API FastAPI, usada SOMENTE pelo servidor do Next.js
WORKER_API_URL=http://127.0.0.1:8000
# Opcional, somente servidor do painel: criar/convidar usuários na tela Usuários.
# Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# BACKEND / WORKER (.env na raiz do projeto ou worker/.env)
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon key: a API executa as RPCs com o JWT do usuário (RLS e auditoria)
SUPABASE_ANON_KEY=

SIAT_BASE_URL=https://siatweb.sefaz.pi.gov.br
# Keycloak que pede o certificado (janela nativa); alvo da política do Chrome
SIAT_CERTIFICATE_AUTH_URL=https://siatweb-certificado.sefaz.pi.gov.br
# padrão da política do Chrome (todos os hosts da SEFAZ-PI; e-AGEAT tem login próprio)
CHROME_POLICY_PATTERN=https://[*.]sefaz.pi.gov.br

DOWNLOAD_BASE_PATH=./storage/downloads
BROWSER_PROFILE_BASE_PATH=./storage/browser_profiles
ERROR_SCREENSHOT_PATH=./storage/errors
STEP_SCREENSHOT_PATH=./storage/screenshots

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Chave Fernet para o cofre em arquivo (fallback do Windows Credential Manager).
# Gere com: python -m app.tools.generate_key
SECRET_ENCRYPTION_KEY=
# auto (keyring -> arquivo cifrado) | keyring | encrypted_file
SECRET_BACKEND=auto

# ---------------------------------------------------------------------
# Automação
# ---------------------------------------------------------------------
# Desenvolvimento: navegador visível para acompanhar o robô
AUTOMATION_HEADLESS=false
# status das NFC-e exportadas: ativas | canceladas | todas
NFCE_STATUS=todas
# NF-e (emitidas e recebidas): status ativas|canceladas|inutilizadas|denegadas|todas e tipo todas|entrada|saida
NFE_STATUS=ativas
NFE_TIPO_NOTA=todas
# e-AGEAT: tentativas de abrir (erro 500 / Usuario nao identificado); a pausa cresce a cada tentativa (5s, 10s, 15s...)
MODULE_OPEN_ATTEMPTS=7
MODULE_RETRY_DELAY=5
# true = preenche os formulários mas NÃO clica no botão final de agendamento
AUTOMATION_DRY_RUN=true
# true = screenshot de cada etapa em storage/screenshots/{job}/
AUTOMATION_SCREENSHOTS=false
# chrome | msedge | chromium (Web PKI do SIAT funciona melhor no Chrome instalado)
BROWSER_CHANNEL=chrome
# navegadores simultâneos (1 = sequencial, recomendado com certificados)
MAX_PARALLEL_JOBS=1

# Timeouts (ms)
PAGE_LOAD_TIMEOUT=60000
ACTION_TIMEOUT=30000
DOWNLOAD_TIMEOUT=120000
LOGIN_DETECTION_TIMEOUT=20000
CERTIFICATE_SELECTION_TIMEOUT=300000
MANUAL_ACTION_TIMEOUT=900000

# Fila / Collector
WORKER_POLL_INTERVAL=5
COLLECTOR_POLL_INTERVAL=60
COLLECTOR_INTERVAL_MINUTES=30
COLLECTOR_MAX_CHECKS=96
STALE_LOCK_MINUTES=45
RETRY_DELAYS=10,30,60
MAX_ATTEMPTS=3

# Política AutoSelectCertificateForUrls do Chrome (ver docs/certificate-setup.md)
# disabled | per_job
CHROME_POLICY_MODE=disabled
CHROME_POLICY_ALLOW_WRITE=false

# Sobrescrita de seletores do SIAT sem alterar código (opcional)
# SIAT_SELECTORS_FILE=./worker/config/siat_selectors.json

LOG_LEVEL=INFO
